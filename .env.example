# IP público da instância; sem protocolo ou porta.
SERVER_IP=203.0.113.10
SERVER_NAME=Valheim ARM
WORLD_NAME=Dedicated
SERVER_PASSWORD=troque-esta-senha
PUBLIC=true
CROSSPLAY=false
# Opcional: Normal, Casual, Easy, Hard, Hardcore, Immersive, Hammer.
PRESET=
# Vazios preservam o comportamento do mundo/preset.
MODIFIER_COMBAT=
MODIFIER_DEATHPENALTY=
MODIFIER_RESOURCES=
MODIFIER_RAIDS=
MODIFIER_PORTALS=
KEY_NOBUILDCOST=false
KEY_PLAYEREVENTS=false
KEY_PASSIVEMOBS=false
KEY_NOMAP=false
SAVE_INTERVAL=1800
NATIVE_BACKUPS=4
TIMEZONE=America/Sao_Paulo
# "off" desativa a tarefa.
RESTART_AT=05:00
BACKUP_AT=05:00
AUTO_UPDATE=true
UPDATE_INTERVAL=1800
RETAIN_DAILY=7
RETAIN_WEEKLY=4
BEPINEX=false
# URL HTTPS de um BepInExPack_Valheim Linux, com hash SHA256 obrigatório.
BEPINEX_URL=
BEPINEX_SHA256=
# latest é resolvido na construção. --no-cache força nova consulta.
FEX_VERSION=latest
BUILD_JOBS=2
FEX_DISKCACHE=1
FEX_DISKCACHEMAXFILESIZE=1073741824
FEX_MAXINST=5000
FEX_MULTIBLOCK=1
# Não desative a ordenação x86 sem testes de correção.
FEX_TSOENABLED=1
