# O instalador preenche estes valores. Configurações extras ficam no painel.
SERVER_IP=203.0.113.10
SERVER_NAME=Meu Valheim
WORLD_NAME=Dedicated
SERVER_PASSWORD=troque-esta-senha

# Opcional: Steam e consoles. Também pode ser alterado no painel.
CROSSPLAY=false
# Opcional: fixe uma versão publicada, por exemplo hfgalmeida/valheim-arm:0.1.0.
# VALHEIM_IMAGE=hfgalmeida/valheim-arm:latest

# Opcional: limites do contêiner Valheim (padrão para instância de 12 GiB).
VALHEIM_MEMORY_LIMIT=10g
# Total de RAM + swap: 14g permite até 4 GiB de swap, se existir no host.
VALHEIM_MEMORY_SWAP_LIMIT=14g
